# Copy this file to .env and fill in real values. Never commit .env.
# On Heroku these are set as config vars instead.
DATABASE_URL=
ANTHROPIC_API_KEY=

# Scraper: contact address put in the User-Agent (sites like sec.gov require one)
SCRAPER_CONTACT=
# Optional: where scraped pages go (default data/output/scrape). On SCC point this at project space.
SCRAPER_OUT=
# Internal documents (markdown .txt + metadata.csv). Must be outside the repo or gitignored.
INTERNAL_DIR=
INTERNAL_OUT=

# Optional semantic-chunking model (independent of final retrieval model selection).
# Pass --model or export this variable; chunker does not load .env itself.
CHUNK_EMBED_MODEL=all-MiniLM-L6-v2

# Shared retrieval/ingestion embeddings must match migration 001 (384 dimensions).
EMBED_MODEL=all-MiniLM-L6-v2
# Local defaults; hosted launch: MCP_HOST=0.0.0.0, PORT supplied by host.
MCP_HOST=127.0.0.1
PORT=8000
# Host-header allowlist, not authentication. Add the actual deployed hostname.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
# Client decision: both are served without login. May be narrowed to public.
MCP_ALLOWED_VISIBILITY=public,internal
