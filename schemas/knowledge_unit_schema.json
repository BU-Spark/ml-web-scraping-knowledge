{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sales Knowledge Unit Schema v0.2 (First-Principles Epistemic Contract)",
  "description": "Contract for discrete, source-supported sales knowledge units aligned with the Salesforce Unified Context Layer (UCL) Information Spectrum.",
  "type": "object",
  "required": [
    "unit_id",
    "chunk_id",
    "section_id",
    "claim",
    "actionable_step",
    "evidence_quote",
    "level",
    "level_rationale",
    "specificity_score",
    "is_obvious_to_layperson",
    "unit_type",
    "context",
    "outcome",
    "topic",
    "category",
    "source_url",
    "domain",
    "publisher",
    "published_date",
    "page_title",
    "heading",
    "source_type",
    "sensitivity",
    "source_tier",
    "authority_weight",
    "canonical_claim_hash",
    "corroborating_sources",
    "corroboration_count",
    "extracted_at",
    "embed_text",
    "embedding"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "section_id": {
      "type": "integer",
      "minimum": 0
    },
    "claim": {
      "type": "string",
      "minLength": 15,
      "description": "One standalone, de-contextualized sentence stating the finding or actionable practice."
    },
    "actionable_step": {
      "type": [
        "string",
        "null"
      ],
      "description": "Concrete operational mechanism or tactical move a seller executes (required for know_how; null if pure statistic or lacking a concrete mechanism)."
    },
    "evidence_quote": {
      "type": "string",
      "minLength": 10,
      "description": "Exact verbatim substring from the source chunk (may join two spans from the chunk with '...')."
    },
    "level": {
      "type": "string",
      "enum": [
        "common_sense",
        "content",
        "know_how",
        "knowledge"
      ],
      "description": "UCL Information Spectrum level. Retention rule: keep know_how and knowledge; drop common_sense and content."
    },
    "level_rationale": {
      "type": "string",
      "minLength": 10,
      "description": "First-principles justification for why this unit belongs to its level on the Information Spectrum."
    },
    "specificity_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "1 = truism/platitude; 2 = generic textbook theory; 3 = named tactical mechanism; 4 = stage/segment-specific workflow; 5 = empirically measured or case-proven finding."
    },
    "is_obvious_to_layperson": {
      "type": "boolean",
      "description": "Counterfactual layperson test: True if a non-salesperson would already agree with the advice without domain training (forces common_sense drop)."
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "how_to",
        "definition",
        "statistic",
        "example"
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "who",
        "industry",
        "company_size",
        "situation"
      ],
      "properties": {
        "who": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "company_size": {
          "type": "string",
          "minLength": 1
        },
        "situation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explicitly measured result, quantitative benchmark, or proven case outcome from the text, or null if the source only recommends an action."
    },
    "topic": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical snake_case or short phrase label (e.g., 'BANT', 'call coaching', 'objection handling') normalizing terminology across sources."
    },
    "category": {
      "type": "string",
      "enum": [
        "1. Sales Methodology and Process",
        "2. Segmentation and Territory",
        "10. Enablement Operations"
      ]
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "published_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "string"
    },
    "char_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "char_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_type": {
      "type": "string",
      "enum": [
        "external",
        "internal"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "source_tier": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "authority_weight": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "canonical_claim_hash": {
      "type": "string",
      "minLength": 8
    },
    "corroborating_sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "corroboration_count": {
      "type": "integer",
      "minimum": 1
    },
    "extracted_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "embed_text": {
      "type": "string",
      "minLength": 15
    },
    "embedding": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": false
}
