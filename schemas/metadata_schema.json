{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sales Knowledge Unit Provenance and Source Metadata Schema v0.2",
  "description": "Validates code-populated source attribution, chunk provenance, canonical topic clustering, and multi-source corroboration metadata.",
  "type": "object",
  "required": [
    "unit_id",
    "chunk_id",
    "section_id",
    "source_url",
    "domain",
    "publisher",
    "published_date",
    "page_title",
    "heading",
    "source_type",
    "sensitivity",
    "source_tier",
    "authority_weight",
    "canonical_claim_hash",
    "corroborating_sources",
    "corroboration_count",
    "extracted_at"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "section_id": {
      "type": "integer",
      "minimum": 0
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "published_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_title": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "string"
    },
    "char_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "char_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_type": {
      "type": "string",
      "enum": [
        "external",
        "internal"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "source_tier": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "description": "1 = Primary/Institutional Authority (Salesforce, Trailhead, Gartner, HBR, McKinsey, Forrester); 2 = Vetted Sales Practitioner Benchmark (Gong, HubSpot, Outreach, RAIN Group, Korn Ferry); 3 = General Public Web."
    },
    "authority_weight": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Prior authority score derived from source_tier and corroboration for downstream hybrid ranking."
    },
    "canonical_claim_hash": {
      "type": "string",
      "minLength": 8,
      "description": "Deterministic fingerprint of (category, topic, normalized claim/action) for cross-source clustering."
    },
    "corroborating_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_url",
          "publisher",
          "source_tier",
          "evidence_quote",
          "chunk_id"
        ],
        "properties": {
          "source_url": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "source_tier": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "evidence_quote": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          }
        }
      }
    },
    "corroboration_count": {
      "type": "integer",
      "minimum": 1
    },
    "extracted_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": true
}
